# Server Configurations
PORT=5001
NODE_ENV=development

# MySQL Database Configurations (Option A: Individual Variables)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=github_analyzer

# MySQL Database Configurations (Option B: Unified Connection string)
# If provided, DATABASE_URL/MYSQL_URL will be used in place of individual variables above.
DATABASE_URL=mysql://root:password@127.0.0.1:3306/github_analyzer

# CORS Policy Configuration
# Lock down the API to only allow requests from your frontend Vercel domain in production
FRONTEND_URL=https://gitgauge.vercel.app

# GitHub API Configurations
# Highly recommended: Add a Personal Access Token (PAT) below to increase rate limit from 60 to 5000 req/hr
GITHUB_API_TOKEN=

